{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.local/schemas/provider-capabilities.schema.json",
  "title": "Provider Adapter Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "adapter_version",
    "protocol",
    "authentication",
    "capabilities",
    "operations"
  ],
  "properties": {
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "authentication": {
      "enum": [
        "available",
        "unavailable",
        "expired",
        "interactive-required"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "streaming",
          "tool-calling",
          "structured-output",
          "session-resume",
          "cancellation",
          "vision",
          "mcp",
          "acp"
        ]
      }
    },
    "context_window_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "effect_class",
        "idempotent",
        "material_cost",
        "approval"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "effect_class": {
          "enum": [
            "idempotent-read",
            "idempotent-write",
            "paid-inference",
            "non-idempotent-write",
            "production",
            "credential"
          ]
        },
        "idempotent": {
          "type": "boolean"
        },
        "material_cost": {
          "type": "boolean"
        },
        "approval": {
          "enum": [
            "never",
            "policy",
            "always"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect_class": {
                "enum": [
                  "paid-inference",
                  "non-idempotent-write",
                  "production",
                  "credential"
                ]
              }
            },
            "required": [
              "effect_class"
            ]
          },
          "then": {
            "properties": {
              "idempotent": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
