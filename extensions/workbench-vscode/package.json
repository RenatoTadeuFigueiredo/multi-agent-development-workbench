{
  "name": "workbench-vscode",
  "displayName": "Workbench Sessions",
  "description": "Observe and control local Workbench sessions.",
  "version": "0.1.0",
  "engines": { "vscode": ">=1.90.0" },
  "activationEvents": [
    "onCommand:workbench.newSession",
    "onCommand:workbench.selectSession",
    "onCommand:workbench.attach",
    "onCommand:workbench.prompt",
    "onCommand:workbench.pause",
    "onCommand:workbench.resume",
    "onCommand:workbench.cancel",
    "onCommand:workbench.redirect",
    "onCommand:workbench.resolveApproval"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": { "title": "Workbench", "properties": {
      "workbench.endpoint": {
        "type": "string",
        "default": "",
        "scope": "resource",
        "description": "Optional absolute local Workbench daemon socket endpoint for the current workspace."
      }
    }},
    "commands": [
      { "command": "workbench.newSession", "title": "Workbench: New Session" },
      { "command": "workbench.selectSession", "title": "Workbench: Select Session" },
      { "command": "workbench.attach", "title": "Workbench: Attach Session" },
      { "command": "workbench.prompt", "title": "Workbench: Send Prompt" },
      { "command": "workbench.pause", "title": "Workbench: Pause Session" },
      { "command": "workbench.resume", "title": "Workbench: Resume Session" },
      { "command": "workbench.cancel", "title": "Workbench: Cancel Session" },
      { "command": "workbench.redirect", "title": "Workbench: Redirect Session" },
      { "command": "workbench.resolveApproval", "title": "Workbench: Resolve Approval" }
    ]
  },
  "scripts": { "compile": "tsc -p .", "test": "node --test dist/test/*.test.js" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.0"
  }
}
