{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.local/schemas/workbench-lock.schema.json",
  "title": "Workbench Deterministic Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "configuration",
    "protocol",
    "adapters",
    "models",
    "mcps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "enum": [
        "repository",
        "session"
      ]
    },
    "base_lock_hash": {
      "$ref": "#/$defs/digest"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "hash_algorithm",
        "resolved_hash"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "hash_algorithm": {
          "const": "blake3-256"
        },
        "resolved_hash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "adapters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/adapter"
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "mcps": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mcp"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "session"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "required": [
          "base_lock_hash"
        ]
      },
      "else": {
        "not": {
          "required": [
            "base_lock_hash"
          ]
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "executable_sha256"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "runtime_model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "runtime_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
